# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / OS scratch
*.swp
*.tmp
Thumbs.db

# Dependencies (if a build step is ever introduced)
node_modules/

# Environment / secrets — never commit real keys
.env
.env.*
*.local

# Local backups (dated copies live here; not part of the shipped app)
_backup/

